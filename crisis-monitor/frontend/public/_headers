# The start page and the notification worker must always be checked for a new version after a deploy.
# Built asset files carry a content hash in their name, so they can be cached for a year.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
